+/***********************************************************************
+ *              macdrv_get_cocoa_window_number
+ *
+ * Returns the window server number of a Cocoa window, or 0 if it has
+ * none yet (deferred windows get one when first ordered in).
+ */
+int macdrv_get_cocoa_window_number(macdrv_window w)
+{
+    WineWindow* window = (WineWindow*)w;
+    __block NSInteger number;
+
+    OnMainThread(^{
+        number = [window windowNumber];
+    });
+    return number > 0 ? (int)number : 0;
+}
+
+/***********************************************************************
+ *              macdrv_order_cocoa_window_above_number
+ *
+ * Order an on-screen Cocoa window just above a window given by its
+ * window server number, which may belong to another process.  Used for
+ * Wine child windows whose parent lives in another process.
+ */
+void macdrv_order_cocoa_window_above_number(macdrv_window w, int number)
+{
+    WineWindow* window = (WineWindow*)w;
+
+    OnMainThreadAsync(^{
+        if ([window isVisible] && ![window isMiniaturized])
+            [window orderWindow:NSWindowAbove relativeTo:number];
+    });
+}
+
