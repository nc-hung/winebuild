+    /* Whether any window other than a child of another process's window is
+       shown with something to see, or is minimized to the Dock. */
+    - (BOOL) showsOrdinaryWindow
+    {
+        for (WineWindow* window in [NSApp windows])
+        {
+            if (![window isKindOfClass:[WineWindow class]] || window.foreignChild)
+                continue;
+            if ([window isMiniaturized] || ([window isOrderedIn] && [window presentsVisibleContent]))
+                return TRUE;
+        }
+        return FALSE;
+    }
+
+    /* For a process whose only windows are children of another process's
+       windows (shown on screen through their own Mac windows): it can own
+       windows and be activated, but gets no Dock icon or menu bar.  A later
+       ordinary window still makes it a regular app, and it goes back to
+       being an accessory app when only such children are left (AIR's
+       preloader shows an ordinary window first, and keeps a zero-size one). */
+    - (void) transformProcessToAccessory
+    {
+        NSApplicationActivationPolicy policy = [NSApp activationPolicy];
+
+        if (policy == NSApplicationActivationPolicyProhibited)
+        {
+            [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+            [self disableAppNap];
+        }
+        else if (policy == NSApplicationActivationPolicyRegular && ![self showsOrdinaryWindow])
+            [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+    }
+
+    /* Called when a window is ordered out or becomes such a child.  A
+       process left with no window to show at all (a launcher that hides
+       itself after starting another program) also goes back to being an
+       accessory app, after a short delay so that going from one window to
+       the next doesn't make its Dock icon flicker. */
+    - (void) transformProcessToAccessoryIfNothingShown
+    {
+        if ([NSApp activationPolicy] != NSApplicationActivationPolicyRegular || [self showsOrdinaryWindow])
+            return;
+
+        for (WineWindow* window in [NSApp windows])
+        {
+            if ([window isKindOfClass:[WineWindow class]] && window.foreignChild && [window isOrderedIn])
+            {
+                [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+                return;
+            }
+        }
+
+        [NSObject cancelPreviousPerformRequestsWithTarget:self
+                                                 selector:@selector(transformProcessToAccessoryIfStillNothingShown)
+                                                   object:nil];
+        [self performSelector:@selector(transformProcessToAccessoryIfStillNothingShown)
+                   withObject:nil
+                   afterDelay:2
+                      inModes:@[NSRunLoopCommonModes]];
+    }
+
+    - (void) transformProcessToAccessoryIfStillNothingShown
+    {
+        if ([NSApp activationPolicy] == NSApplicationActivationPolicyRegular && ![self showsOrdinaryWindow])
+            [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+    }
+
     - (BOOL) waitUntilQueryDone:(bool*)done timeout:(NSDate*)timeout processEvents:(BOOL)processEvents
     {
         PerformRequest(NULL);
