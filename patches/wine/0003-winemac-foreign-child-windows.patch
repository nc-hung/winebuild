+/***********************************************************************
+ *              is_foreign_window
+ *
+ * Whether a window belongs to another process.
+ */
+static BOOL is_foreign_window(HWND hwnd)
+{
+    DWORD pid = 0;
+
+    return NtUserGetWindowThread(hwnd, &pid) && pid != GetCurrentProcessId();
+}
+
+
+/***********************************************************************
+ *              get_cocoa_toplevel
+ *
+ * Return the ancestor of a window that owns its Mac window: the root
+ * window, or for a window inside another process's window, the topmost
+ * ancestor that still belongs to this process.
+ */
+HWND get_cocoa_toplevel(HWND hwnd)
+{
+    HWND parent, top = hwnd, desktop = NtUserGetDesktopWindow();
+
+    while ((parent = NtUserGetAncestor(top, GA_PARENT)) && parent != desktop && !is_foreign_window(parent))
+        top = parent;
+    return top;
+}
+
+
+/***********************************************************************
+ *              get_cocoa_frame
+ *
+ * Return the frame of the Mac window in screen coordinates.  A child of
+ * another process's window keeps its rects relative to the parent's
+ * client area, so map them to the screen.
+ */
+static CGRect get_cocoa_frame(struct macdrv_win_data *data)
+{
+    RECT rect = data->rects.visible;
+
+    if (data->foreign_parent)
+    {
+        HWND parent = NtUserGetAncestor(data->hwnd, GA_PARENT);
+        NtUserMapWindowPoints(parent, 0, (POINT *)&rect, 2, NtUserGetWinMonitorDpi(parent, MDT_RAW_DPI));
+    }
+    return cgrect_from_rect(rect);
+}
+
+
+/***********************************************************************
+ *              order_above_foreign_parent
+ *
+ * Order the Mac window of a child of another process's window just
+ * above the Mac window of its top-level ancestor.  number is that Mac
+ * window's number, or 0 to look it up.
+ */
+static void order_above_foreign_parent(struct macdrv_win_data *data, int number)
+{
+    if (!data->cocoa_window || !data->on_screen) return;
+    if (!number)
+        number = (UINT_PTR)NtUserGetProp(NtUserGetAncestor(data->hwnd, GA_ROOT), mac_window_number_prop);
+    TRACE("win %p/%p above Mac window %d\n", data->hwnd, data->cocoa_window, number);
+    if (number) macdrv_order_cocoa_window_above_number(data->cocoa_window, number);
+}
+
+
+/***********************************************************************
+ *              sync_foreign_children
+ *
+ * Tell windows of other processes that are descendants of hwnd, and so
+ * have their own Mac windows, to follow hwnd's position and Z-order.
+ */
+static void sync_foreign_children(HWND hwnd, int number)
+{
+    HWND child;
+
+    for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child;
+         child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        if (is_foreign_window(child))
+            NtUserPostMessage(child, WM_MACDRV_SYNC_FOREIGN_CHILD, number, 0);
+        else
+            sync_foreign_children(child, number);
+    }
+}
+
+
+/***********************************************************************
+ *              sync_all_foreign_children
+ *
+ * Call sync_foreign_children for all top-level windows of this process.
+ */
+static void sync_all_foreign_children(void)
+{
+    HWND hwnd;
+
