# Pinned versions for the ~/winebuild stack. Change here, then re-run the build-*.sh scripts.
WB_ROOT="${WB_ROOT:-$HOME/winebuild}"

MOLTENVK_REPO=https://github.com/KhronosGroup/MoltenVK.git
MOLTENVK_TAG=v1.4.2

WINE_REPO=https://gitlab.winehq.org/wine/wine.git
WINE_TAG=wine-11.0

DXVK_REPO=https://github.com/Gcenx/DXVK-macOS.git
DXVK_TAG=v1.10.3-20230507

# x86_64 libraries for Wine, built from source by build-deps-x86.sh (no x86_64 Homebrew on macOS 27).
DEPS_X86="$WB_ROOT/deps/x86_64"
GMP_URL=https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz
GMP_SHA256=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898
NETTLE_URL=https://ftp.gnu.org/gnu/nettle/nettle-3.10.2.tar.gz
NETTLE_SHA256=fe9ff51cb1f2abb5e65a6b8c10a92da0ab5ab6eaf26e7fc2b675c45f1fb519b5
GNUTLS_URL=https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz
GNUTLS_SHA256=ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e
FREETYPE_URL=https://download.savannah.gnu.org/releases/freetype/freetype-2.15.0.tar.xz
FREETYPE_SHA256=93cd47eb719c325107f2d3cf087d06299e944c3b48a40b55537302304dea1dd5
SDL2_URL=https://github.com/libsdl-org/SDL/releases/download/release-2.32.10/SDL2-2.32.10.tar.gz
SDL2_SHA256=5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165

WB_SRC="$WB_ROOT/src"
WB_BUILD="$WB_ROOT/build"
WB_DIST="$WB_ROOT/dist"
WB_LOGS="$WB_ROOT/logs"
WB_PATCHES="$WB_ROOT/patches"

# arm64 build tools (bison/flex are keg-only in Homebrew).
export PATH="/opt/homebrew/opt/bison/bin:/opt/homebrew/opt/flex/bin:/opt/homebrew/bin:$PATH"
JOBS="$(sysctl -n hw.ncpu)"

# Clone $1 at tag $2 into $3 (shallow), or verify an existing checkout is at that tag.
wb_checkout() {
    local repo=$1 tag=$2 dir=$3
    if [ ! -d "$dir/.git" ]; then
        git clone -q --depth 1 --branch "$tag" "$repo" "$dir"
    else
        local have
        have=$(git -C "$dir" describe --tags --exact-match 2>/dev/null || true)
        if [ "$have" != "$tag" ]; then
            git -C "$dir" fetch -q --depth 1 origin tag "$tag"
            git -C "$dir" checkout -q "$tag"
        fi
    fi
}

# Apply every patch in $WB_PATCHES/$1 to $2 unless already applied.
wb_apply_patches() {
    local name=$1 dir=$2 p
    [ -d "$WB_PATCHES/$name" ] || return 0
    for p in "$WB_PATCHES/$name"/*.patch; do
        [ -e "$p" ] || continue
        if git -C "$dir" apply --check "$p" 2>/dev/null; then
            git -C "$dir" apply "$p" && echo "applied $(basename "$p")"
        elif git -C "$dir" apply --reverse --check "$p" 2>/dev/null; then
            echo "already applied $(basename "$p")"
        else
            echo "patch $(basename "$p") does not apply" >&2; return 1
        fi
    done
}
